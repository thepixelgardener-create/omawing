#!/usr/bin/env python3
# Rebuild the original gameplay cues; the supplied MP3s are left untouched.
from pathlib import Path
import math,random,struct,wave
directory=Path(__file__).resolve().parent.parent/'src/audio'
rate=44100
rng=random.Random(42)

def write(name, out):
 with wave.open(str(directory/(name+'.wav')),'wb') as wav:
  wav.setnchannels(1);wav.setsampwidth(2);wav.setframerate(rate)
  wav.writeframes(struct.pack('<'+'h'*len(out),*out))

# Ring chimes: a bell (a sine with a few slightly stretched partials) that
# arpeggiates up a major chord, a shimmer on top, and a short echo for
# space. Each step of a chain is a step higher on a major pentatonic scale.
def chime(step):
 root=659.25*2**([0,2,4,7,9,12,14,16][step]/12)
 duration=1.1; n=round(duration*rate); dry=[0.0]*n
 for at,ratio,gain in [(0,1,.30),(.045,1.25,.22),(.09,1.5,.20),(.135,2,.18)]:
  freq=root*ratio; start=round(at*rate)
  for i in range(start,n):
   t=(i-start)/rate
   env=min(1,t/.003)*math.exp(-t*5.5)
   bell=math.sin(2*math.pi*freq*t)+.35*math.sin(2*math.pi*freq*2.01*t)*math.exp(-t*4)+.12*math.sin(2*math.pi*freq*3.02*t)*math.exp(-t*9)
   dry[i]+=gain*env*bell
 for i in range(n):
  t=i/rate
  dry[i]+=.05*math.sin(2*math.pi*root*4*t+3*math.sin(2*math.pi*7*t))*math.exp(-t*7)*min(1,t/.02)
 wet=dry[:]
 for delay,gain in [(.083,.28),(.137,.2),(.211,.13)]:
  d=round(delay*rate)
  for i in range(d,n): wet[i]+=gain*dry[i-d]
 peak=max(abs(v) for v in wet) or 1
 out=[]
 for i,v in enumerate(wet):
  v=v/peak*.8*min(1,(n-i)/(.05*rate))
  out.append(max(-32767,min(32767,round(v*32767))))
 return out

for step in range(8):
 write('ring%d'%(step+1), chime(step))

for name,duration in [('boost',.65),('impact',.30),('wreck',1.3)]:
 # The first ring sound used to come between boost and impact; skip its
 # share of the noise so impact and wreck stay exactly as they were.
 if name=='impact':
  for _ in range(round(.55*rate)): rng.uniform(-1,1)
 out=[]; low=0.0; phase=0.0
 for i in range(round(duration*rate)):
  t=i/rate; u=t/duration; noise=rng.uniform(-1,1)
  low+=.13*(noise-low)
  if name=='boost':
   phase+=2*math.pi*(100+500*u*u)/rate
   value=(.6*low+.12*math.sin(phase))*math.sin(math.pi*u)**1.1
  elif name=='impact':
   phase+=2*math.pi*(55+120*math.exp(-t*30))/rate
   value=(.55*low+.20*noise+.3*math.sin(phase))*min(1,t/.003)*math.exp(-t*17)
  else:
   phase+=2*math.pi*(32+75*math.exp(-t*6))/rate
   value=(.75*low+.16*noise+.22*math.sin(phase))*min(1,t/.008)*math.exp(-t*3.6)
  value*=min(1,(duration-t)/.03)
  out.append(max(-32767,min(32767,round(value*32767))))
 write(name,out)
