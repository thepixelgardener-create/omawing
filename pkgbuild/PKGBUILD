pkgname=omawing
pkgver=0.4.0
pkgrel=1
pkgdesc='Amiga-style vector flight demo'
url='https://github.com/thepixelgardener-create/omawing'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-multimedia')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omawing "$pkgdir/usr/bin/omawing"
  install -Dm644 -t "$pkgdir/usr/share/omawing/music" src/audio/*.mp3
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omawing.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omawing.svg"
  install -Dm644 "$startdir/omawing.desktop" "$pkgdir/usr/share/applications/omawing.desktop"
}
