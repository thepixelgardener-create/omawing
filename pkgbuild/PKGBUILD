# Builds the working tree as a package, for bin/install. The release recipe
# is aur/PKGBUILD; the two describe the same package, so keep them alike.
pkgname=omawing
pkgver=0.4.0
pkgrel=1
pkgdesc='Amiga-style vector flight demo and arcade game for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/thepixelgardener-create/omawing'
# The code is MIT; the bundled Gemini soundtrack is not (see LICENSE).
license=('MIT' 'LicenseRef-omawing-soundtrack')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-multimedia' 'qt6-svg' 'gcc-libs' 'glibc')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  # Build with Arch's compiler and linker flags (hardening included), in a
  # folder of its own, so nothing from a development build is reused.
  OMAWING_BUILD_DIR="$srcdir/build" ./bin/build \
    QMAKE_CFLAGS_RELEASE="$CFLAGS" \
    QMAKE_CXXFLAGS_RELEASE="$CXXFLAGS" \
    QMAKE_LFLAGS_RELEASE="$LDFLAGS"
}

package() {
  cd "$startdir/.."
  install -Dm755 "$srcdir/build/omawing" "$pkgdir/usr/bin/omawing"
  install -Dm644 -t "$pkgdir/usr/share/omawing/music" src/audio/*.mp3
  install -Dm644 pkgbuild/omawing.desktop "$pkgdir/usr/share/applications/omawing.desktop"
  install -Dm644 pkgbuild/omawing.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omawing.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
